<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext permitido solo para compatibilidad con servidores HTTP antiguos de audio directo. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
